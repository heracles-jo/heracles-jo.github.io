#!/bin/sh
set -eu

expected='heracles.jo <heracles.jo@gmail.com> | heracles.jo <heracles.jo@gmail.com>'
zero='0000000000000000000000000000000000000000'

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi

  for commit in $(git rev-list "$range"); do
    actual=$(git show -s --format='%an <%ae> | %cn <%ce>' "$commit")
    if [ "$actual" != "$expected" ]; then
      printf >&2 'BLOCKED: commit %s has invalid identity\n  actual:   %s\n  expected: %s\n' \
        "$commit" "$actual" "$expected"
      exit 1
    fi
  done
done
