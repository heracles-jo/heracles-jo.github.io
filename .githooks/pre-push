#!/bin/sh
set -eu

expected='heracles.jo <heracles.jo@gmail.com> | heracles.jo <heracles.jo@gmail.com>'
zero='0000000000000000000000000000000000000000'

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    # A new branch still shares history already present on the remote. Audit only
    # commits this push introduces, not every ancestor reachable from local_sha.
    commits=$(git rev-list "$local_sha" --not --remotes="$1")
  else
    commits=$(git rev-list "$remote_sha..$local_sha")
  fi

  for commit in $commits; do
    actual=$(git show -s --format='%an <%ae> | %cn <%ce>' "$commit")
    if [ "$actual" != "$expected" ]; then
      printf >&2 'BLOCKED: commit %s has invalid identity\n  actual:   %s\n  expected: %s\n' \
        "$commit" "$actual" "$expected"
      exit 1
    fi
  done
done
